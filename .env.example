# =============================================================
#  Jansky — API Keys
# =============================================================
#  Copy this file to .env and fill in your keys.
#
#    cp .env.example .env
#
#  All keys are OPTIONAL. Jansky works without them, but you
#  lose the corresponding feature (see table below).
#
#  ┌────────────────────────┬────────────────────────────────┐
#  │ Variable               │ Feature unlocked               │
#  ├────────────────────────┼────────────────────────────────┤
#  │ OPENWEATHER_API_KEY    │ Live weather lookups           │
#  │ NEWSAPI_KEY            │ Top news headlines             │
#  │ GEMINI_API_KEY         │ Cloud AI answers (Gemini)      │
#  │ MOONSHOT_API_KEY       │ (legacy) treated as GEMINI key │
#  └────────────────────────┴────────────────────────────────┘
# =============================================================

OPENWEATHER_API_KEY=
NEWSAPI_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
